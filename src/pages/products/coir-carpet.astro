---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const applications = [
  'Outdoor Exhibition Aisles',
  'Open-Air Display Grounds',
  'Main Entrances & Forecourts',
  'Hall Approaches & Walkways',
  'Indoor Hall Aisles',
  'Heavy-Machinery & Infrastructure Shows',
  'Pavilion Surrounds',
  'Registration & Arrival Zones',
];

const gallery = [
  { src: 'bauma-outdoor-avenue', alt: 'Long outdoor aisle at Bauma ConExpo India 2026 between Terex and Finlay displays, laid end to end in Sanchi coir-type structured carpet', cls: 'sc-gal__item--wide', pos: 'center 80%' },
  { src: 'bauma-outdoor-aisle', alt: 'Outdoor aisle at Bauma ConExpo India 2026 lined with exhibitor pavilions, laid in Sanchi coir-type structured carpet', cls: 'sc-gal__item--tall' },
  { src: 'bauma-gateway',       alt: 'Zone A gateway in the Bauma ConExpo India 2026 outdoor area, structured carpet running through the arch', cls: '' },
  { src: 'bauma-jcb',           alt: 'Outdoor machinery display at Bauma ConExpo India 2026 with structured carpet aisles', cls: '' },
  { src: 'bauma-hall-16',       alt: 'Approach to Hall 16 at Bauma ConExpo India 2026, laid in coir-type structured carpet', cls: '' },
  { src: 'bauma-outdoor-cranes', alt: 'Visitors walking a structured carpet aisle beneath crane displays in the Bauma ConExpo India 2026 outdoor area', cls: '' },
  { src: 'bauma-entrance-opening', alt: 'Opening day at the Bauma ConExpo India 2026 main entrance — confetti across the coir-type structured carpet forecourt', cls: 'sc-gal__item--wide' },
  { src: 'bauma-hall-7',       alt: 'Hall 7 frontage at Bauma ConExpo India 2026 with structured carpet forecourt', cls: 'sc-gal__item--wide' },
];

const faqs = [
  {
    q: 'What is coir-type structured carpet?',
    a: 'Structured carpet is a firm, textured exhibition carpet built for heavy footfall. Our coir-type design is a structured carpet developed in-house by Sanchi Enterprises, with a woven, herringbone-style surface that gives the look and grip of natural coir matting. Structured carpets themselves are not new — this particular design is ours, and it was laid for the first time in India at Bauma ConExpo India 2026.',
  },
  {
    q: 'Where was this design first used?',
    a: 'Bauma ConExpo India 2026, held at India Expo Centre & Mart, Greater Noida, from 15 to 18 September 2026. Sanchi Enterprises was the Official Carpeting Service Provider and laid the coir-type structured carpet across the entire outdoor exhibition area and in several halls.',
  },
  {
    q: 'Can it be laid outdoors?',
    a: 'Yes. At Bauma ConExpo India 2026 the carpet covered the full outdoor area — open-air aisles, machinery display grounds, entrances, and hall approaches — as well as indoor hall aisles. Share your venue and layout and we will confirm suitability for your site.',
  },
  {
    q: 'How do I order coir-type structured carpet for an event?',
    a: 'Share your event brief, venue, floor plan dimensions, and event dates. We will confirm availability, quantity, and the installation timeline. Contact us via the enquiry form or WhatsApp.',
  },
];
---

<Layout
  title="Coir-Type Structured Carpet — Our Design, First Laid in India | Sanchi Enterprises"
  description="Coir-type structured carpet — an in-house Sanchi Enterprises design, laid for the first time in India across the entire outdoor area and several halls of Bauma ConExpo India 2026. Supplied and installed across India."
  ogImage="https://sanchienterprises.com/images/structured/bauma-outdoor-aisle-1280w.webp"
  ogImageWidth="1280"
  ogImageHeight="960"
  breadcrumbs={[
    { name: 'Products', item: 'https://sanchienterprises.com/products' },
    { name: 'Coir-Type Structured Carpet', item: 'https://sanchienterprises.com/products/coir-carpet' },
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/structured/structured-hero-poster-1280w.webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://sanchienterprises.com/products/coir-carpet/#service",
          "name": "Coir-Type Structured Carpet",
          "description": "In-house coir-type structured carpet design by Sanchi Enterprises, first laid in India at Bauma ConExpo India 2026 across the full outdoor area and several halls. Supplied and installed across India.",
          "serviceType": "Structured Exhibition Carpet Supply and Installation",
          "provider": { "@id": "https://sanchienterprises.com/#organization" },
          "url": "https://sanchienterprises.com/products/coir-carpet",
          "image": "https://sanchienterprises.com/images/structured/bauma-outdoor-aisle-1280w.webp",
          "areaServed": { "@type": "Country", "name": "India" },
          "additionalProperty": [
            { "@type": "PropertyValue", "name": "Design", "value": "In-house coir-type structured pattern" },
            { "@type": "PropertyValue", "name": "First installation", "value": "Bauma ConExpo India 2026, India Expo Centre & Mart, Greater Noida" },
            { "@type": "PropertyValue", "name": "Coverage", "value": "Pan-India supply and installation" }
          ],
          "offers": {
            "@type": "Offer",
            "priceCurrency": "INR",
            "availability": "https://schema.org/InStock",
            "url": "https://sanchienterprises.com/products/coir-carpet",
            "seller": { "@type": "Organization", "name": "Sanchi Enterprises" },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "INR",
              "price": "0",
              "description": "Custom quotation based pricing. Contact for pricing."
            }
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": faqs.map(faq => ({
            "@type": "Question",
            "name": faq.q,
            "acceptedAnswer": { "@type": "Answer", "text": faq.a }
          }))
        }
      ]
    })}></script>
  </Fragment>

  <Navbar />
  <main>

    <!-- ─── HERO — full-viewport, Bauma outdoor footage ──────────── -->
    <section class="coir-hero" aria-labelledby="coir-heading">
      <div class="coir-hero__media" aria-hidden="true">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster="/images/structured/structured-hero-poster-1280w.webp"
          class="coir-hero__video"
        >
          <source src="/images/structured/structured-hero.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="coir-hero__overlay" aria-hidden="true"></div>
      <div class="container">
        <div class="coir-hero__content">
          <a href="/products" class="coir-hero__back" data-animate>
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
              <path d="M11 4H1M5 1L1 4l4 3" stroke="currentColor" stroke-width="1.3"
                stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            All Products
          </a>
          <span class="eyebrow eyebrow--inverse eyebrow--line" data-animate data-delay="1">Coir-Type Structured Carpet</span>
          <h1 class="coir-hero__title" id="coir-heading" data-animate data-delay="2">
            Our Design.<br />Laid First in India.
          </h1>
          <p class="coir-hero__sub" data-animate data-delay="3">
            A structured carpet developed in-house by Sanchi — debuted across the entire
            outdoor area and several halls of Bauma ConExpo India 2026.
          </p>
        </div>
      </div>
      <div class="coir-hero__scroll" aria-hidden="true">
        <div class="coir-hero__scroll-line"></div>
      </div>
    </section>

    <!-- ─── STATEMENT ────────────────────────────────────────────── -->
    <div class="coir-statement" aria-label="Product positioning">
      <div class="container">
        <div class="coir-statement__inner" data-animate="reveal-up">
          <p class="coir-statement__text">
            Structured carpet isn't new.<br />
            <span class="coir-statement__em">This design is — and it was ours first.</span>
          </p>
        </div>
      </div>
    </div>

    <!-- ─── EDITORIAL SPLIT — texture left, about text right ─────── -->
    <div class="coir-split" aria-labelledby="coir-about-heading">
      <div class="coir-split__visual" data-animate="image">
        <img
          src="/images/structured/structured-texture-1280w.webp"
          srcset="/images/structured/structured-texture-640w.webp 640w, /images/structured/structured-texture-1280w.webp 1280w"
          sizes="(max-width: 860px) 100vw, 50vw"
          alt="Close view of Sanchi coir-type structured carpet — herringbone-style woven texture in deep red"
          loading="lazy"
          decoding="async"
          width="1280"
          height="960"
        />
      </div>
      <div class="coir-split__text">
        <div class="coir-split__text-inner" data-animate data-delay="1">
          <span class="eyebrow eyebrow--line">About the Design</span>
          <h2 class="coir-split__title" id="coir-about-heading">
            The Look of Coir.<br />Built for the Show Floor.
          </h2>
          <p class="coir-split__body">
            Our coir-type structured carpet carries the woven, herringbone character of natural
            coir matting in a firm structured carpet made for exhibition footfall. The pattern
            was developed in-house by Sanchi Enterprises — structured carpets are an established
            category, but this design had never been laid in India before.
          </p>
          <p class="coir-split__body">
            Its debut was at one of the country's largest trade shows: Bauma ConExpo India 2026,
            where it covered every outdoor aisle, machinery ground, and hall approach, and ran
            through several indoor halls. Enquire for availability for your event dates.
          </p>
        </div>
      </div>
    </div>

    <!-- ─── CASE STUDY — Bauma ConExpo India 2026 ────────────────── -->
    <section class="sc-case" aria-labelledby="sc-case-heading">
      <div class="container">
        <div class="sc-case__head">
          <div data-animate>
            <span class="eyebrow eyebrow--inverse eyebrow--line">Project · First Installation</span>
            <h2 class="sc-case__title" id="sc-case-heading" data-animate="reveal-up">
              Bauma ConExpo<br />India 2026.
            </h2>
          </div>
          <dl class="sc-case__facts" data-animate data-delay="2">
            <div class="sc-case__fact"><dt>Role</dt><dd>Official Carpeting Service Provider</dd></div>
            <div class="sc-case__fact"><dt>Venue</dt><dd>India Expo Centre &amp; Mart, Greater Noida</dd></div>
            <div class="sc-case__fact"><dt>Dates</dt><dd>15–18 September 2026</dd></div>
            <div class="sc-case__fact"><dt>Scope</dt><dd>Entire outdoor area + several halls</dd></div>
          </dl>
        </div>

        <div class="sc-gal">
          {gallery.map((g, i) => (
            <figure class={`sc-gal__item ${g.cls}`} data-animate="image" data-delay={String((i % 4) + 1)}>
              <img
                src={`/images/structured/${g.src}-1280w.webp`}
                srcset={`/images/structured/${g.src}-640w.webp 640w, /images/structured/${g.src}-1280w.webp 1280w`}
                sizes="(max-width: 768px) 100vw, 50vw"
                alt={g.alt}
                style={g.pos ? `object-position: ${g.pos}` : undefined}
                loading="lazy"
                decoding="async"
                width="1280"
                height="960"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── APPLICATIONS ─────────────────────────────────────────── -->
    <div class="prod-section" aria-labelledby="coir-apps-heading">
      <div class="container">
        <div class="prod-section__header" data-animate>
          <span class="eyebrow eyebrow--line">Applications</span>
          <h2 class="prod-section__title" id="coir-apps-heading">Where It Performs</h2>
        </div>
        <div class="prod-apps-grid" data-animate data-delay="1">
          {applications.map((app) => (
            <div class="prod-app-item">
              <div class="prod-app-item__dot"></div>
              <div class="prod-app-item__label">{app}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ─── SPEC STRIP ────────────────────────────────────────────── -->
    <div class="coir-specs" aria-label="Product specification">
      <div class="container">
        <div class="coir-specs__grid" data-animate>
          <div class="coir-specs__item">
            <span class="coir-specs__label">Design</span>
            <span class="coir-specs__value">In-house coir-type structured pattern</span>
          </div>
          <div class="coir-specs__item">
            <span class="coir-specs__label">Debut</span>
            <span class="coir-specs__value">Bauma ConExpo India 2026</span>
          </div>
          <div class="coir-specs__item">
            <span class="coir-specs__label">Proven</span>
            <span class="coir-specs__value">Outdoor aisles &amp; indoor halls</span>
          </div>
          <div class="coir-specs__item">
            <span class="coir-specs__label">Coverage</span>
            <span class="coir-specs__value">Pan-India supply &amp; installation</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── FAQ ──────────────────────────────────────────────────── -->
    <div class="prod-section prod-section--stone" aria-labelledby="coir-faq-heading">
      <div class="container">
        <div class="prod-section__header" data-animate>
          <span class="eyebrow eyebrow--line">FAQ</span>
          <h2 class="prod-section__title" id="coir-faq-heading">Common Questions</h2>
        </div>
        <div data-animate data-delay="1">
          <FAQAccordion faqs={faqs} />
        </div>
      </div>
    </div>

    <!-- ─── RELATED PRODUCTS ─────────────────────────────────────── -->
    <div class="prod-section" aria-label="Related products">
      <div class="container">
        <div class="prod-section__header" data-animate>
          <span class="eyebrow eyebrow--line">Also Available</span>
          <h2 class="prod-section__title">Explore Our Range</h2>
        </div>
        <div class="coir-related" data-animate data-delay="1">
          <a href="/products/grass-carpet" class="coir-related__link">
            <span class="coir-related__name">Grass Carpet</span>
            <span class="coir-related__desc">Synthetic grass for themed exhibition environments</span>
          </a>
          <a href="/products/loop-pile-carpet" class="coir-related__link">
            <span class="coir-related__name">Loop Pile Carpet</span>
            <span class="coir-related__desc">Structured cut-loop surface in 6 architectural tones</span>
          </a>
          <a href="/products/non-woven-carpet" class="coir-related__link">
            <span class="coir-related__name">Non Woven Carpet</span>
            <span class="coir-related__desc">29 shades — industry standard floor coverage</span>
          </a>
          <a href="/products/designer-carpet" class="coir-related__link">
            <span class="coir-related__name">Designer Carpet</span>
            <span class="coir-related__desc">Fully custom printed to your brief</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ─── CTA ──────────────────────────────────────────────────── -->
    <div class="prod-cta">
      <div class="container">
        <div class="prod-cta__inner">
          <div class="prod-cta__text" data-animate>
            <div class="prod-cta__title">Enquire about Structured Carpet</div>
            <p class="prod-cta__sub">
              Share your event brief, venue, and floor plan.
              We'll confirm specification and availability within 24 hours.
            </p>
          </div>
          <div class="prod-cta__actions" data-animate data-delay="1">
            <a href="/contact" class="btn btn--ghost-light">Send Enquiry</a>
            <a
              href="https://wa.me/919958132189"
              class="btn btn--whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp Us
            </a>
          </div>
        </div>
      </div>
    </div>

  </main>
  <Footer />
</Layout>

<style>
  /* ─── Hero ──────────────────────────────────────────────────────── */
  .coir-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-bottom: var(--sp-8);
    background-color: var(--color-navy-dark);
  }
  .coir-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .coir-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }
  .coir-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 12, 36, 0.97) 0%,
      rgba(8, 12, 36, 0.65) 38%,
      rgba(8, 12, 36, 0.26) 72%,
      rgba(8, 12, 36, 0.14) 100%
    );
  }
  .coir-hero__content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    padding-top: 140px;
  }
  .coir-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(247, 246, 243, 0.40);
    margin-bottom: var(--sp-5);
    transition: color 0.22s var(--ease-out);
  }
  .coir-hero__back:hover { color: rgba(247, 246, 243, 0.80); }
  .coir-hero__title {
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 84px);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.032em;
    color: var(--color-text-inverse);
    margin-top: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .coir-hero__sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.3vw, 17px);
    line-height: 1.72;
    color: rgba(247, 246, 243, 0.58);
    max-width: 440px;
  }
  .coir-hero__scroll {
    position: absolute;
    bottom: 40px;
    right: 48px;
    z-index: 2;
  }
  .coir-hero__scroll-line {
    width: 1px;
    height: 70px;
    background: linear-gradient(to bottom, transparent, rgba(247, 246, 243, 0.40));
    animation: coir-scroll 2.8s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes coir-scroll {
    0%, 100% { opacity: 0.30; transform: scaleY(0.5); }
    55%       { opacity: 0.85; transform: scaleY(1); }
  }

  /* ─── Statement ─────────────────────────────────────────────────── */
  .coir-statement {
    background: var(--color-warm-white);
    padding: var(--sp-9) 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .coir-statement__inner { max-width: 720px; }
  .coir-statement__text {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 32px);
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: -0.016em;
    color: rgba(12, 18, 48, 0.45);
    margin: 0;
  }
  .coir-statement__em {
    color: var(--color-navy-dark);
    font-weight: 700;
  }

  /* ─── Editorial split ───────────────────────────────────────────── */
  .coir-split {
    display: flex;
    min-height: 580px;
    overflow: hidden;
    background: var(--color-stone);
  }
  .coir-split__visual {
    flex: 0 0 50%;
    overflow: hidden;
  }
  .coir-split__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    transition: transform 0.85s var(--ease-out);
  }
  .coir-split:hover .coir-split__visual img { transform: scale(1.04); }
  .coir-split__text {
    flex: 1;
    display: flex;
    align-items: center;
    padding: var(--sp-8) var(--sp-7);
  }
  .coir-split__text-inner { max-width: 480px; }
  .coir-split__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-navy-dark);
    margin-top: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .coir-split__body {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.1vw, 15px);
    line-height: 1.80;
    color: var(--color-text-secondary);
    margin-bottom: var(--sp-4);
  }
  .coir-split__body:last-child { margin-bottom: 0; }

  /* ─── Spec strip ────────────────────────────────────────────────── */
  .coir-specs {
    background: var(--color-navy-dark);
    padding: var(--sp-6) 0;
  }
  .coir-specs__grid {
    display: flex;
    gap: 0;
  }
  .coir-specs__item {
    flex: 1;
    padding: var(--sp-4) var(--sp-5);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .coir-specs__item:first-child { padding-left: 0; }
  .coir-specs__item:last-child  { border-right: none; }
  .coir-specs__label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(247, 246, 243, 0.35);
  }
  .coir-specs__value {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: rgba(247, 246, 243, 0.88);
  }


  /* ─── Case study ───────────────────────────────────────────────── */
  .sc-case {
    background: var(--color-navy-dark);
    padding: var(--sp-9) 0;
    color: var(--color-text-inverse);
  }
  .sc-case__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
